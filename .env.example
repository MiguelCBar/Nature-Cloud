# Copy this file to .env and fill in your values. Never commit .env.

# AWS credentials and region
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Absolute path to your downloaded .pem file (used for SSH)
AWS_EC2_SSH_KEYPAR_PATH=

# Name of the key pair as registered in the AWS Console
AWS_KEYPAIR_NAME=

# Security group ID. Must allow inbound SSH (22) and the web server / master ports
AWS_SECURITY_GROUP=

# Instance profile for workers (needs write access to DynamoDB)
IAM_INSTANCE_PROFILE_NAME=

# Instance profile for the master node
AWS_MASTER_IAM_PROFILE=

# Port the master node listens on
LOAD_BALANCER_PORT=
